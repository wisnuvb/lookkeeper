# Binaries and build output
/lockkeeper
/dist/
*.exe
*.test
*.out
coverage.*

# Local config, secrets and state (never commit)
/lockkeeper.yaml
/*.local.yaml
*.db
*.db-wal
*.db-shm
*.key
*.pem
.env
.env.*
master.key
secrets/

# Web UI (ADR 0006): dependencies and build output are never committed
/web/node_modules/
/web/dist/
/web/*.tsbuildinfo

# Embedded copy of the built UI (the placeholder stays tracked)
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Editor / OS
.idea/
.vscode/
.DS_Store

# Agent worktrees
.claude/worktrees/
